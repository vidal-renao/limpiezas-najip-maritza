# ─── D'Namar Basel – Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in the values before running the project.
# NEVER commit .env.local to version control.

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Create a free account at https://resend.com and generate an API key.
# The sending domain (dnamar.ch) must be verified in the Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Contact destination ────────────────────────────────────────────────────────
# Email address that receives contact form submissions and quote requests.
# Defaults to info@dnamar.ch if not set.
CONTACT_EMAIL=info@dnamar.ch

# ── Supabase ───────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Settings → API → Project URL and anon public key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
