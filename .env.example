# ─── D'Namar Basel – Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in the values before running the project.
# NEVER commit .env.local to version control.

# ── Email (SMTP nativo – NOVATREND, Swiss hosted) ──────────────────────────────
# Swiss-hosted SMTP server via NOVATREND (mail.dnamar.ch), SSL port 465.
# SPF/DKIM aligned — sender must match SMTP_USER.
SMTP_HOST=mail.dnamar.ch
SMTP_PORT=465
SMTP_USER=info@dnamar.ch
SMTP_PASSWORD=your-smtp-password-here

# ── Contact destination ────────────────────────────────────────────────────────
# Email address that receives contact form submissions and quote requests.
# Defaults to info@dnamar.ch if not set.
CONTACT_EMAIL=info@dnamar.ch

# ── Supabase ───────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Settings → API → Project URL and anon public key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Optional: service role key for admin operations (bypasses RLS).
# Settings → API → service_role key. Keep this secret — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin Panel ────────────────────────────────────────────────────────────────
# Password for the /admin panel (Najip's review moderation dashboard).
# Use a strong, random string — e.g.: openssl rand -base64 32
ADMIN_SECRET=change-me-to-a-strong-random-secret
